{{ include "/etc/skel/.bashrc" }}

{{ if lookPath "brew" -}} 
eval "$($HOME/.homebrew/bin/brew shellenv)"
{{ end -}}

{{ if lookPath "mise" -}}
eval "$($HOME/.local/bin/mise activate bash)"
{{ end -}}

{{ if lookPath "starship" -}}
eval "$(starship init bash)"
{{ end -}}

{{ if lookPath "fzf" -}}
eval "$(fzf --bash)"
{{ end -}}

